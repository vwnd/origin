# Copy to .dev.vars for local development (`.dev.vars` is gitignored).
# In production set these with `wrangler secret put <NAME>`.

# Speckle Personal Access Token (Profile -> Developer Settings -> Access Tokens).
# Scope required: streams:write
SPECKLE_TOKEN=""

# Secret configured on the project webhook (Project -> Settings -> Webhooks).
# Speckle signs each delivery with HMAC-SHA256 using this value.
SPECKLE_WEBHOOK_SECRET=""
