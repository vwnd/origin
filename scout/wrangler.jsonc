{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scout",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/oauth/*", "/webhooks/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ChatAgent"],
      "tag": "v1"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom metrics for the Speckle webhook pipeline. Query with the
  // Analytics Engine SQL API — see the README.
  "analytics_engine_datasets": [
    {
      "binding": "SCOUT_ANALYTICS",
      "dataset": "scout_speckle_deliveries"
    }
  ],
  // Lets each data point and log line name the deployment that produced it.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
