<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Minio" Version="7.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Speckle.Sdk" Version="2026.6.0" />
    <!-- Speckle.Sdk pulls SQLitePCLRaw 2.1.11 transitively, which carries CVE-2025-6965.
         2.1.13 bundles a patched SQLite and is API compatible. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <!-- Task briefs under the fleet root are embedded so the development seeder can
       build convention documents without depending on the working directory. -->
  <ItemGroup>
    <EmbeddedResource Include="../../fleet/tasks/*.md" LogicalName="FleetTasks.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
